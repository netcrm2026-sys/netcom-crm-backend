{
  "name": "netcom-crm",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.netcom.crm",
    "productName": "NetCom CRM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "index.js"
    ],
    "win": {
      "target": "portable",
      "icon": "public/logo.png"
    },
    "portable": {
      "artifactName": "NetComCRM.exe"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "^10.7.0",
    "googleapis": "^173.0.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "vite": "^8.0.13"
  }
}
